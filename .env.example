# ---------------------------------------------------------------------------
# AI-Powered Incident Detection & Resolution Assistant - environment template
# Copy to `.env` at the repo root. Every value has a working default, so the
# app boots with an EMPTY .env in fully-free "demo" mode.
# ---------------------------------------------------------------------------

# --- LLM ---------------------------------------------------------------
# Leave blank to run in deterministic demo mode (no cost, no key needed).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=4000

# --- Database ------------------------------------------------------------
# Blank -> local SQLite at backend/data/runtime/app.db
# postgresql+psycopg://user:pass@host/db to run against real Postgres.
DATABASE_URL=

# --- Retrieval -------------------------------------------------------------
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=24

# --- Incident detection ------------------------------------------------
# Log lines within this many seconds of an existing incident's last event,
# with a matching error fingerprint, are folded into it instead of opening
# a new incident.
INCIDENT_WINDOW_SECONDS=900
CONFIDENCE_THRESHOLD=0.55

# --- OpenTelemetry -----------------------------------------------------
# Blank -> spans are captured in-process and shown on the dashboard, no
# external collector required. Set to export to a real OTLP endpoint too
# (Honeycomb, Jaeger, Grafana Tempo, ...).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=incident-assistant

# --- App ---------------------------------------------------------------
APP_ENV=local
SEED_ON_STARTUP=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins (e.g. your own Vercel preview URLs).
CORS_ORIGIN_REGEX=
# When set, approval decisions (which execute fixes) require an X-Admin-Token
# header with this value. Blank = open demo mode.
ADMIN_TOKEN=
SERVE_FRONTEND=true
